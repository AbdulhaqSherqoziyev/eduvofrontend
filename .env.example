# Base URL of the EDU-ERP backend API (NestJS). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000/api


# mock.eduvo.uz (all optional; inlined at build time)
# Support Telegram handle shown on /help/contact, e.g. @eduvo_support. Empty → email only.
NEXT_PUBLIC_MOCK_SUPPORT_TELEGRAM=
# IELTS Speaking launch flag (B2C): 1 → Speaking shown where the catalog has it; empty/0 → hidden everywhere.
NEXT_PUBLIC_SPEAKING_LIVE=
